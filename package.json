{
  "name": "roundtable",
  "private": true,
  "version": "0.1.0",
  "description": "Roundtable — live multi-participant transcription powered by the Gemini Live API (GDG FCRIT Bit N Build 2026).",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "lint": "npm run lint -w client",
    "test": "npm run test -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
